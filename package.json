    "opportunities:sync": "node tools/sync-opportunities.mjs",
    "opportunity-detail:sync": "node tools/sync-opportunity-detail.mjs",
    "activities:sync": "node tools/sync-activities.mjs",
    "prospects:sync": "node tools/sync-prospects.mjs",
    "drilldown:sync": "node tools/sync-drilldown.mjs",
    "home:sync": "node tools/sync-home.mjs",
    "schedule:sync": "node tools/sync-schedule.mjs",
    "receipts:sync": "node tools/sync-receipts.mjs",
    "sales-dashboard:sync": "node tools/sync-sales-dashboard.mjs",
    "smart-doc:sync": "node tools/sync-smart-doc.mjs",
    "receipt-form:sync": "node tools/sync-receipt-form.mjs",
    "sales-doc-list:sync": "node tools/sync-sales-doc-list.mjs",
    "sales-doc-form:sync": "node tools/sync-sales-doc-form.mjs",
    "compare": "node tools/compare/run.mjs",
    "workspace": "node tools/workspace.mjs"
