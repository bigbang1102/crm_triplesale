{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "5c6a0566-a428-45d0-9c99-2a9dfa98e4cc"
  },
  "newProjectRoot": "projects",
  "projects": {
    "triple-sale-angular": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "ts",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "app-config.json",
                "input": "config/prod",
                "output": "config"
              }
            ],
            "styles": [
              "node_modules/@fortawesome/fontawesome-free/css/fontawesome.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/regular.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/solid.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/brands.min.css",
              "node_modules/primeicons/primeicons.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "150kB",
                  "maximumError": "200kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "app-config.json",
                  "input": "config/dev",
                  "output": "config"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "docker": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "app-config.json",
                  "input": "config/docker",
                  "output": "config"
                }
              ],
              "outputHashing": "all"
            },
            "live": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "app-config.json",
                  "input": "config/live",
                  "output": "config"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "mockup-tenant": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "app-config.json",
                  "input": "config/mockup-tenant",
                  "output": "config"
                }
              ],
              "optimization": false,
              "outputHashing": "all",
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.cjs"
          },
          "configurations": {
            "production": {
              "buildTarget": "triple-sale-angular:build:production"
            },
            "development": {
              "buildTarget": "triple-sale-angular:build:development"
            },
            "live": {
              "buildTarget": "triple-sale-angular:build:live"
            },
            "mockup-tenant": {
              "buildTarget": "triple-sale-angular:build:mockup-tenant"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
